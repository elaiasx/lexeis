# ============================================================
#  LEXILOGEION — Περιβαλλοντικές Μεταβλητές (αντιγράψτε σε .env.local)
#  ΣΗΜΑΝΤΙΚΟ: Ποτέ μην κάνετε commit το .env.local στο git!
# ============================================================

# Firebase — Public keys (ασφαλές να εκτεθούν στο browser, 
# η ασφάλεια βασίζεται στους Firebase Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Εφαρμογή
NEXT_PUBLIC_APP_VERSION=5.0.0
NEXT_PUBLIC_APP_NAME=Λεξιλόγειον

# Προαιρετικό: Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS=true
