# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Admin SDK (server-only)
# To enable Firebase Admin features such as elevated access to the
# Realtime Database or Cloud Functions you need a service account
# JSON. The easiest method is to export the fields as environment
# variables. See README for details.
FIREBASE_ADMIN_PROJECT_ID=YOUR_FIREBASE_ADMIN_PROJECT_ID
FIREBASE_ADMIN_CLIENT_EMAIL=YOUR_FIREBASE_ADMIN_CLIENT_EMAIL
# Do NOT store the private key in source. On Vercel/GitHub use secrets.
# FIREBASE_ADMIN_PRIVATE_KEY should be set in project secrets (no quotes, newline-encoded)

# Security
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Feature Flags
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_CHALLENGES=true
NEXT_PUBLIC_ENABLE_MULTIPLAYER=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
